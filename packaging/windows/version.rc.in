#include <winver.h>

; ---------------------------------------------------------------------------
; Generated by CMake from version.rc.in -- edit version.rc.in, never the
; generated version.rc.
;
; Do NOT put markdown backticks (or any other C-preprocessor metacharacter)
; in this file. rc.exe runs the MSVC preprocessor over it, so a backtick is
; not inert comment text: it fails the resource compile with
; "RC2018: unknown character '0x60'" and then "RC1116: RC terminating after
; preprocessor errors", killing the Windows build before it can link.
; Reference CMakeLists.txt without quoting.
;
; Every field below comes from project(BucharestLite VERSION ...) in the
; top-level CMakeLists.txt. The numeric FILEVERSION/PRODUCTVERSION used to be
; hand-maintained alongside BL_VERSION_STR, and the two drifted apart: the
; 1.7.38 release shipped an exe whose fixed file info still read 1.0.1.0 while
; only the string fields said 1.7.38, so Explorer's Details tab, the
; Programs-and-Features entry and the NSIS DisplayVersion all disagreed.
; Deriving both from PROJECT_VERSION makes that unrepresentable.
; ---------------------------------------------------------------------------

#define BL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define BL_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define BL_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define BL_VERSION_BUILD @BL_VERSION_BUILD@
#define BL_VERSION_STR "@PROJECT_VERSION@"

; The icon sits next to this template in the source tree; the generated .rc
; lives in the build tree, so the path has to be absolute or rc.exe would
; look for the .ico relative to the build directory.
IDI_ICON1 ICON DISCARDABLE "@CMAKE_CURRENT_LIST_DIR@/bucharest-lite.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BL_VERSION_MAJOR,BL_VERSION_MINOR,BL_VERSION_PATCH,BL_VERSION_BUILD
 PRODUCTVERSION BL_VERSION_MAJOR,BL_VERSION_MINOR,BL_VERSION_PATCH,BL_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BucharestLite"
            VALUE "FileDescription", "BucharestLite non-linear video editor"
            VALUE "FileVersion", BL_VERSION_STR
            VALUE "InternalName", "bucharest-lite"
            VALUE "LegalCopyright", "Copyright (C) 2026 BucharestLite contributors"
            VALUE "OriginalFilename", "bucharest-lite.exe"
            VALUE "ProductName", "BucharestLite"
            VALUE "ProductVersion", BL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END