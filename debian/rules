#!/usr/bin/make -f
%:
	dh $@

# CMAKE_BUILD_TYPE has to be passed explicitly. Without it dh_auto_configure
# configures with an empty build type, which means no -O flags at all: the
# resulting binary is a debug-grade build shipped as a release package.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DBL_BUILD_TESTS=OFF \
		-DBL_BUILD_UI=ON \
		-DBL_BUILD_PLUGINS=ON \
		-DBL_BUILD_EXPORT=ON

override_dh_auto_test:

# dh_installdocs only picks up README/CHANGELOG/TODO etc.; ship the roff man
# page explicitly or lintian reports no-manual-page.
override_dh_auto_install:
	dh_auto_install
	dh_installman docs/bucharest-lite.1