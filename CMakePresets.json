{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BL_BUILD_TESTS": "ON",
                "BL_BUILD_EXPORT": "ON"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-tsan",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BL_ENABLE_TSAN": "ON"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows/${presetName}",
            "cacheVariables": {
                "BL_BUILD_TESTS": "ON",
                "BL_BUILD_EXPORT": "ON",
                "FFMPEG_ROOT": "$env{FFMPEG_ROOT}"
            }
        },
        {
            "name": "windows-debug",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
            }
        },
        {
            "name": "windows-release",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-tsan",
            "configurePreset": "linux-tsan"
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        }
    ],
    "testPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "linux-tsan",
            "configurePreset": "linux-tsan",
            "output": { "outputOnFailure": true },
            "environment": {
                "TSAN_OPTIONS": "ignore_interceptors_accesses=1"
            }
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug",
            "output": { "outputOnFailure": true },
            "environment": {
                "QT_QPA_PLATFORM": "offscreen"
            }
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "output": { "outputOnFailure": true },
            "environment": {
                "QT_QPA_PLATFORM": "offscreen"
            }
        }
    ]
}
